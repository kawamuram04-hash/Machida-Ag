<body>
<div class="container">
    <header>
        <h1>⌨ ハンドの手入力 (.direct)</h1>
        <div style="font-size: 1.4rem;">📝</div>
    </header>
    <div class="sub-header-alert">※文字でパチパチ入力したい方は、ここから作業をしてください。</div>

    <!-- ユーザー様設計：2ボックス式入力エリア -->
    <div class="input-box-group">
        <label class="input-label">▼ キーボード手入力ボックス</label>
        <input type="text" id="rawTextBox" class="text-field" placeholder="例: SAKHQT9D765C432" autocomplete="off">
    </div>

    <!-- スクリーニング・正規化後の美しいディスプレイモニター -->
    <div class="input-box-group">
        <label class="input-label">▼ マトリックス正規化・並び替えモニター</label>
        <div class="display-monitor">
            <div class="display-text" id="displayText"></div>
            <div class="counter-badge" id="cardCounter">0</div>
        </div>
    </div>

    <div class="guidance-box" id="guidanceBox">キーボードから手札を文字で入力してください。</div>

    <button class="clear-action-btn" id="clearBtn">ボックスを空にする</button>

    <!-- 確定送信ボタン -->
    <div class="action-container">
        <button id="okActionBtn" class="action-btn" disabled>OK (スプレッドシートへ確定送信)</button>
    </div>
</div>

<script>
    // ⚠️登録係の画面（initialize）の最上部に貼ってあるURL変数を、ここにも1行丸ごとコピペしてください。
    const GAS_URL = "https://script.google.com/macros/s/AKfycbygAPVWSVTInhfQ3cx3-VkQk1WhHVA3iozzCn3--FuJh5-DPIRSBFZb4ubCRkTCav-QfQ/exec";

    const RANKS = ['A', 'K', 'Q', 'J', 'T', '9', '8', '7', '6', '5', '4', '3', '2'];
    const SUITS = ['S', 'H', 'D', 'C'];

    // ユーザー様プロト思想：鉄壁の4×13マトリックス正規化バッファ
    let cardMatrix = {
        S: new Array(13).fill(""),
        H: new Array(13).fill(""),
        D: new Array(13).fill(""),
        C: new Array(13).fill("")
    };

    const rawTextBox = document.getElementById('rawTextBox');
    const displayText = document.getElementById('displayText');
    const cardCounter = document.getElementById('cardCounter');
    const guidanceBox = document.getElementById('guidanceBox');
    const okActionBtn = document.getElementById('okActionBtn');
    const clearBtn = document.getElementById('clearBtn');

    // 全角英数字を半角に変換する親切関数
    function toHalfWidth(str) {
        return str.replace(/[Ａ-Ｚａ-ｚ０-９]/g, function(s) {
            return String.fromCharCode(s.charCodeAt(0) - 0xFEE0);
        });
    }

    function countSelectedCards() {
        let total = 0;
        SUITS.forEach(suit => {
            total += cardMatrix[suit].filter(val => val !== "").length;
        });
        return total;
    }

    // ★ユーザー様プロトの魂：リアルタイム・スクリーニング＆正規化エンジン
    rawTextBox.addEventListener('input', () => {
        // 1. 全角を半角化 ➔ 大文字化 ➔ 空白を完全除去
        let rawText = toHalfWidth(rawTextBox.value).toUpperCase().replace(/\s+/g, '');

        // 2. トランプの「10」をシステム共通の「T」へ置換
        rawText = rawText.replace(/10/g, 'T');

        // 3. マトリックスの初期化
        SUITS.forEach(suit => cardMatrix[suit].fill(""));

        // 4. 文字列を実直に走査し、余分な文字をフィルタリングしながらマトリックスへ仕分け
        let currentParsingSuit = null;
        for (let i = 0; i < rawText.length; i++) {
            const char = rawText[i];
            
            if (SUITS.includes(char)) {
                currentParsingSuit = char; // スートの切り替わり
            } else if (currentParsingSuit && RANKS.includes(char)) {
                // 正規ランク文字だけをマトリックスの正しい引き出しへ格納
                const r_ix = RANKS.indexOf(char);
                cardMatrix[currentParsingSuit][r_ix] = char;
            }
        }

        // 5. 画面（モニター）へのリアルタイム同期と枚数計測
        let resultSegments = [];
        SUITS.forEach(suit => {
            let suitStr = suit;
            let hasCards = false;
            RANKS.forEach(rank => {
                const r_ix = RANKS.indexOf(rank);
                if (cardMatrix[suit][r_ix] !== "") {
                    suitStr += rank;
                    hasCards = true;
                }
            });
            if (hasCards) resultSegments.push(suitStr);
        });

        const generatedText = resultSegments.join('');
        displayText.innerText = generatedText; // バラバラに打たれても、常に完璧に整列された文字を左詰め出力
        
        const count = countSelectedCards();
        cardCounter.innerText = count;

        // 6. アラート（ガイダンス）とOKボタンの制御
        if (count === 13) {
            guidanceBox.innerHTML = "<span style='color:var(--btn-blue); font-weight:bold;'>✓ １３枚揃っています。最終確認をして、OKボタンを押して下さい。</span>";
            okActionBtn.disabled = false;
        } else if (count > 13) {
            guidanceBox.innerHTML = "<span style='color:var(--text-alert)'>⚠️ カード枚数が13枚を超えています（現在" + count + "枚）。余分な文字を削ってください。</span>";
            okActionBtn.disabled = true;
        } else {
            guidanceBox.innerHTML = "現在 " + count + " 枚です。13枚ぴったりになるまで入力してください。";
            okActionBtn.disabled = true;
        }
    });

    // クリア処理
    clearBtn.addEventListener('click', () => {
        rawTextBox.value = "";
        SUITS.forEach(suit => cardMatrix[suit].fill(""));
        displayText.innerText = "";
        cardCounter.innerText = "0";
        guidanceBox.innerHTML = "キーボードから手札を文字で入力してください。";
        okActionBtn.disabled = true;
    });

    // ★送信処理（マトリックスから52ビット空間へパースし、実績100%の形式でGAS_URLへ安全POST）
    okActionBtn.addEventListener('click', async () => {
        const count = countSelectedCards();
        if (count !== 13) return;

        let bitVector = new Array(52).fill(false);
        let bitPosition = 0;

        SUITS.forEach(suit => {
            RANKS.forEach(rank => {
                const r_ix = RANKS.indexOf(rank);
                if (cardMatrix[suit][r_ix] !== "") {
bitVector[bitPosition] = true;
}
bitPosition++;
});
});
const int1 = bitVector.slice(0, 26).reduce((acc, curr) => { return (acc << 1) | (curr ? 1 : 0); }, 0);
const int2 = bitVector.slice(26, 52).reduce((acc, curr) => { return (acc << 1) | (curr ? 1 : 0); }, 0);
let bitString = "";
for (let i = 0; i < 52; i++) bitString += bitVector[i] ? "1" : "0";
okActionBtn.disabled = true;
guidanceBox.innerHTML = "🚀 スプレッドシートへデータを安全に送信中...";
try {
const payload = { action: "send_data", int1: int1, int2: int2, raw: bitString };
const response = await fetch(GAS_URL, {
method: "POST",
mode: "cors",
headers: { "Content-Type": "text/plain" },
body: JSON.stringify(payload)
});
const result = await response.json();
if (result.status === "success") {
guidanceBox.innerHTML = "✨ 送信完了：正確なデータがC列・D列に記録されました！ブラウザを閉じて大丈夫です。";
} else { throw new Error(); }
} catch (error) {
guidanceBox.innerHTML = "⚠️ 送信に失敗しました。再起動するか、通信環境を確認してください。";
okActionBtn.disabled = false;
}
});
</script>
</body>
</html>
