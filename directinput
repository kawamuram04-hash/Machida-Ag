            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 480px;
            background: var(--card-bg);
            border-radius: 12px;
            padding: 15px;
            border: 2px solid #2ecc71; /* 手入力専用のクリーンな緑枠 */
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            text-align: center;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
        }

        h1 {
            font-size: 1.4rem;
            font-weight: bold;
            color: #27ae60;
        }

        .sub-header-alert {
            color: var(--text-alert);
            font-weight: bold;
            font-size: 0.95rem;
            margin-bottom: 15px;
        }

        /* ユーザー様設計：2ボックス式インターフェース */
        .input-box-group {
            margin-bottom: 15px;
            text-align: left;
        }

        .input-label {
            font-size: 0.9rem;
