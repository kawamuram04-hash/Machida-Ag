<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>初期化部屋 - Initialize</title>
    <style>
        :root {
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --text-main: #333333;
            --accent-color: #007aff;
            --border-color: #cccccc;
            --success-color: #2ecc71;
            --error-color: #e74c3c;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-main); padding: 15px; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }
        .container { width: 100%; max-width: 480px; background: var(--card-bg); border-radius: 12px; padding: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); border: 2px solid var(--accent-color); text-align: center; }
        h1 { font-size: 1.3rem; margin-bottom: 5px; color: #2c3e50; }
        .version { font-size: 0.85rem; color: #7f8c8d; margin-bottom: 20px; }
        .section-title { font-size: 0.95rem; font-weight: bold; margin: 15px 0 8px 0; color: #16a085; text-align: left; }
        .radio-container { background: #f8f9fa; border: 1px solid var(--border-color); border-radius: 8px; padding: 10px; margin-bottom: 12px; text-align: left; }
        .radio-inline { display: inline-flex; align-items: center; margin-right: 15px; font-size: 1.05rem; font-weight: bold; cursor: pointer; }
        .radio-inline input[type="radio"] { margin-right: 5px; width: 18px; height: 18px; }
        .start-btn { width: 100%; padding: 14px; background: var(--success-color); color: white; border: none; border-radius: 6px; font-size: 1.1rem; font-weight: bold; cursor: pointer; margin-top: 20px; }
        .start-btn:disabled { background: var(--border-color); cursor: not-allowed; }
        .status-box { margin-top: 15px; padding: 12px; border-radius: 6px; font-weight: bold; display: none; }
    </style>
</head>
<body>
<div class="container">
    <h1>♣ ブリッジAI 初期設定 ♦</h1>
    <div class="version">Version: 2026/10/25版</div>
    
    <div class="section-title">▼ ステップ1：ディーラー（親）の選択</div>
    <div class="radio-container">
        <label class="radio-inline"><input type="radio" name="dealer" value="N" checked> N (北)</label>
        <label class="radio-inline"><input type="radio" name="dealer" value="E"> E (東)</label>
        <label class="radio-inline"><input type="radio" name="dealer" value="S"> S (南)</label>
        <label class="radio-inline"><input type="radio" name="dealer" value="W"> W (西)</label>
    </div>

    <div class="section-title">▼ ステップ2：AI (ロボット) の席を選択</div>
    <div class="radio-container">
        <label class="radio-inline"><input type="radio" name="ai_seat" value="N"> N (北)</label>
        <label class="radio-inline"><input type="radio" name="ai_seat" value="E"> E (東)</label>
        <label class="radio-inline"><input type="radio" name="ai_seat" value="S" checked> S (南)</label>
        <label class="radio-inline"><input type="radio" name="ai_seat" value="W"> W (西)</label>
    </div>

    <div class="section-title">▼ ステップ3：AIのプレイスタイル選択</div>
    <div class="radio-container">
        <label class="radio-inline"><input type="radio" name="style" value="Conservative"> 慎重</label>
        <label class="radio-inline"><input type="radio" name="style" value="Standard" checked> 標準</label>
        <label class="radio-inline"><input type="radio" name="style" value="Aggressive"> 積極的</label>
    </div>

    <div class="section-title">▼ ステップ4：設定を確定してゲームを開始</div>
    <button id="initSubmitBtn" class="start-btn">🆕 新しいゲームを開始 (前後分割キー生成)</button>
    <div id="statusReport" class="status-box"></div>
</div>

<script>
    const GAS_URL = "https://script.google.com/macros/s/AKfycbygAPVWSVTInhfQ3cx3-VkQk1WhHVA3iozzCn3--FuJh5-DPIRSBFZb4ubCRkTCav-QfQ/exec";

    document.getElementById('initSubmitBtn').addEventListener('click', async () => {
        const btn = document.getElementById('initSubmitBtn');
        const statusReport = document.getElementById('statusReport');
        const dealer = document.querySelector('input[name="dealer"]:checked').value;
        const ai_seat = document.querySelector('input[name="ai_seat"]:checked').value;
        const style = document.querySelector('input[name="style"]:checked').value;

        btn.disabled = true;
        statusReport.style.display = "block";
        statusReport.style.background = "#e8f8f5";
        statusReport.style.color = "#2ecc71";
        statusReport.innerText = "🚀 スプレッドシート側にXORパターン作成を依頼中...";

        try {
            const response = await fetch(GAS_URL, {
                method: "POST",
                body: JSON.stringify({ action: "start_game", dealer: dealer, ai_seat: ai_seat, style: style })
            });
            const result = await response.json();
            if (result.status === "success") {
                statusReport.innerText = "✨ 初期化完了！XOR基盤が正常に作成されました。";
            } else { throw new Error(); }
        } catch (error) {
            statusReport.style.background = "#fdebd0";
            statusReport.style.color = "#e74c3c";
            statusReport.innerText = "⚠️ 送信失敗。URLまたはシート側の状態を確認してください。";
            btn.disabled = false;
        }
    });
</script>
</body>
</html>
